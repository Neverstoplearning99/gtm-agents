# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override the model. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: comma-separated origins allowed to call the API cross-origin and to
# embed /embed/* in an iframe. Defaults to GTM Play Studio. Use * to allow any origin.
# GROWTHAGENTS_ALLOWED_ORIGINS=https://gtm-play-studio.vercel.app
